{
  "$schema": "zobiris-policy-registry/1.0",
  "registryVersion": "3.1.0-draft",
  "policyVersion": "3.1-draft",
  "asOf": "2026-10-03",
  "deploymentStatus": "DRAFT_NOT_DEPLOYED",
  "registryEnforcement": "NOT_ENFORCED_BY_PRODUCTION",
  "statusSemantics": "Two different things are recorded here. deploymentStatus and registryEnforcement describe this registry: it is a draft that production does not read. Each authorityScopes[].status describes a feature's observed production behavior as recorded in the Release and Experiment Log (DEPLOYED means the code runs in production within that scope), not enforcement by this registry. A DEPLOYED feature therefore runs under its own embedded conventions until production reads this registry and stamps its hash on decisions.",
  "purpose": "Single machine-readable source for authority scopes, controlled vocabularies, fee schedule and decision-affecting parameters. Prose documents reference keys here instead of restating numbers. Values marked DEPLOYED describe production as recorded in whitepaper revision 2.9 and must be re-verified against source before this registry is wired into code.",
  "invariants": {
    "mayWriteExchange": false,
    "automaticPromotion": false,
    "automaticLiveAuthority": false,
    "automaticDemotion": "ALLOWED_FOR_RESEARCH_STATUS_ONLY",
    "unknownIsNotNeutral": true,
    "priceTouchIsNotFill": true,
    "l2DoesNotEstablishQueuePosition": true
  },
  "enums": {
    "featureStatus": {
      "DEPLOYED": "Observed running in production within the stated scope (behavior recorded in the Release Log, not enforcement by this registry)",
      "POLICY_ONLY": "Human evaluation rule; not universally enforced in code",
      "SHADOW_ONLY": "Captured or computed for measurement; no decision authority",
      "PROPOSED": "Specified, not implemented or not wired into production",
      "RETIRED": "No longer used; kept for history"
    },
    "activation": {
      "ACTIVE": "Running and producing data",
      "INACTIVE_MISSING_CREDENTIALS": "Code deployed; provider credentials absent",
      "NOT_WIRED": "Code exists; production does not call it",
      "NOT_BUILT": "No implementation"
    },
    "sizingAuthority": {
      "NONE": "Cannot affect size",
      "CAP_ONLY": "Can bound size by configured caps; cannot raise it",
      "ROUND_DOWN_ONLY": "Exchange rounding and minimums only"
    },
    "evidenceClass": {
      "QUOTE_OUTCOME_ONLY": "Forward price outcome from sampled quotes; no fill reconstruction",
      "L2_EXECUTION_ESTIMATED": "Point-in-time L2 book and trade capture or replay; queue position unknown",
      "L3_QUEUE_INFORMED": "L3 order-level state bounds queue dynamics; a hypothetical order's queue position remains unknown",
      "RECONCILED_REAL_FILL": "Linked to a submitted order and a verified exchange fill with pair, side, quantity, fee and time",
      "PORTFOLIO_REALIZED": "Actual fees, partial fills, realized exits and portfolio interactions reconciled"
    },
    "setupFamily": {
      "RECOVERING_LAGGARD": "Previously weak or lagging asset showing stabilization, easing selling pressure and improving relative behavior",
      "STRONG_COIN_PULLBACK": "Asset with a defensible broader trend retracing toward support with evidence of stabilization",
      "OTHER_OR_UNCLASSIFIED": "Insufficient evidence to classify at decision time"
    },
    "reviewState": [
      "HOLD",
      "WAIT_IN_CASH",
      "KEEP_EXISTING_ORDER",
      "PAUSE_OR_VERIFY_EXISTING_ORDER",
      "REVIEW_QUALIFIED_ENTRY",
      "REVIEW_REDUCTION_OR_HARVEST",
      "RESEARCH_REQUIRED"
    ],
    "existingOrderDisposition": [
      "KEEP",
      "MOVE",
      "PAUSE",
      "VERIFY"
    ],
    "orderGoal": [
      "ACCUMULATE",
      "HARVEST",
      "PROTECT",
      "ROTATE",
      "LEARN"
    ],
    "promotionStage": [
      "1_POINT_IN_TIME_CAPTURE",
      "2_SHADOW_MEASUREMENT_VS_BASELINE",
      "3_CHRONOLOGICAL_OOS_AND_VAULT",
      "4_REALISTIC_FEE_AND_SLIPPAGE_ROBUSTNESS",
      "5_EXECUTION_EVIDENCE_REVIEW",
      "6_EXPLICIT_POLICY_APPROVAL_AND_DEPLOYMENT"
    ],
    "makerTakerPath": [
      "MAKER_MAKER",
      "MAKER_TAKER",
      "TAKER_TAKER"
    ],
    "accountFeeTierAssumption": {
      "TIER_1": "Read from the account; Tier 1 rates",
      "TIER_2": "Read from the account; Tier 2 rates",
      "TIER_3": "Read from the account; Tier 3 rates",
      "TIER_4": "Read from the account; Tier 4 rates",
      "TIER_5": "Read from the account; Tier 5 rates",
      "TIER_6": "Read from the account; Tier 6 rates",
      "TIER_1_UNKNOWN_ACCOUNT_TIER": "Tier not read from the account; Tier 1 rates applied as the fallback"
    },
    "fillLinkage": {
      "VERIFIED": "Linked to a registered shadow order with matching pair, side and time window, an exchange order ID and a verified pair",
      "PARTIAL": "Linked to a shadow order but missing an order ID, pair verification or the time window",
      "UNLINKED": "No shadow order reference"
    },
    "metadataProvenance": {
      "LIVE": "Recorded at decision time from data available then",
      "RECONSTRUCTED": "Assigned after the decision; excluded from certification and vault use",
      "UNKNOWN": "Not recorded; never defaulted to a value"
    }
  },
